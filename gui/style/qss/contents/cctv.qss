#cctv_box {
    border: 1px solid #999;
    border-radius: {{radius}};
}

#detect_log {
    font-size: 16px;
    font-weight: 600;
    color: #333;
    padding: 0 10px;
}

#title {
    font-size: 24px;
    font-weight: 900;
    color: #000;
}

.video_bg {
    background-color: white !important;
    border: 1px solid #ccc;
    border-radius: {{radius}};
}
